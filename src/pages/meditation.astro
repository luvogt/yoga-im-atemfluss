---
import Card from "../components/Card.astro";
import YogaLayout from "../layouts/YogaLayout.astro";
---

<YogaLayout>
    <Card color="#698D5F">
        <div slot="c-header">Mittwoch 19.30 - 21.00</div>
        <div slot="c-main">
            <p class="highlight p-2 text-center">
                Yoga und Meditation zum Ausklang des Tages
            </p>
            <p class="text-center pt-16">03. sept - 26.nov 2025</p>
            <p class="text-center pt-4">14. januar - 18. märz 2026</p>
            <p class="mt-16 text-center">
                Für Anmeldung und Preise bitte Kursdaten anklicken.
            </p>
        </div>
        <div slot="c-footer">
            <strong class="mr-4">VHS City West</strong> Otto-Suhr-Allee 100, 10585 Berlin
        </div>
    </Card>
</YogaLayout>
